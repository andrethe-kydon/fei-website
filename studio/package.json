{
  "name": "fei-studio",
  "version": "1.0.0",
  "private": true,
  "description": "Sanity Studio for the Future Edge Institute website",
  "scripts": {
    "dev": "sanity dev",
    "start": "sanity dev",
    "build": "sanity build",
    "deploy": "sanity deploy",
    "seed": "sanity dataset import seed.ndjson production",
    "seed-aia": "sanity dataset import seed-aia.ndjson production",
    "backfill-series": "sanity exec scripts/backfill-series.js --with-user-token",
    "backfill-series:dry": "sanity exec scripts/backfill-series.js --with-user-token -- --dry-run",
    "backfill-aitags": "sanity exec scripts/backfill-aitags.js --with-user-token",
    "backfill-aitags:dry": "sanity exec scripts/backfill-aitags.js --with-user-token -- --dry-run"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sanity": "^3.57.0",
    "styled-components": "^6.1.13"
  }
}
